{
  "title": "devops-portfolio: web service",
  "uid": "devops-portfolio-web",
  "tags": ["kubernetes", "red-metrics"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate by status",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{namespace=\"devops-portfolio\"}[5m])) by (status)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"devops-portfolio\"}[5m])) by (le, endpoint))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU usage by pod",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"devops-portfolio\", container!=\"\"}[5m])) by (pod)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory working set by pod",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "sum(container_memory_working_set_bytes{namespace=\"devops-portfolio\", container!=\"\"}) by (pod)" }
      ]
    }
  ]
}
