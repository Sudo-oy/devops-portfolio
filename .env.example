# Copy to .env for local runs (python app/app.py). Never commit the real .env file.

# Environment name returned by GET /
APP_ENV=development
# Version returned by GET /
APP_VERSION=
# Port used when running `python app.py` directly
PORT=8080

# Used only to create the Alertmanager secret (see monitoring/alertmanager-config.yaml)
SLACK_WEBHOOK_URL=
