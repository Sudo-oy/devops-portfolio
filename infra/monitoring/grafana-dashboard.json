{
  "dashboard": {
    "id": null,
    "title": "DevOps Portfolio Monitoring",
    "tags": ["k8s", "cpu", "memory"],
    "timezone": "browser",
    "panels": [
      {
        "type": "graph",
        "title": "CPU Usage",
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace='devops-portfolio'}[5m])) by (pod)"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Memory Usage",
        "targets": [
          {
            "expr": "sum(container_memory_usage_bytes{namespace='devops-portfolio'}) by (pod)"
          }
        ]
      }
    ]
  }
}
